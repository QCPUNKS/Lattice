# QCPUNKS SECTOR

# Copy this file to .env and fill in your values. Never commit .env.

# Required
VENICE_API_KEY=

# Optional overrides (defaults shown)
LATTICE_PROVIDER=venice
LATTICE_MODEL=deepseek-v4-flash-0731
# Alternative: Gemini 3.7 Flash via Venice (tool calling, 1M context, reasoning)
# LATTICE_MODEL=gemini-3-7-flash
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Generation defaults
LATTICE_TEMPERATURE=0.3
LATTICE_MAX_TOKENS=4096

# Permission mode: safe | normal | auto
LATTICE_MODE=normal
